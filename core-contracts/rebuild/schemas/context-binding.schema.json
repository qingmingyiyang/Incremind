{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas.local/contracts/context-binding.schema.json",
  "title": "ContextBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "graph_revision", "capability_revision", "compiler_revision", "boundary_revision", "provider_revision", "model_route_revision", "messages", "layers", "layer_token_costs", "total_token_cost", "trimmed_nodes", "excluded_nodes", "stale_nodes", "source_refs", "deterministic_order", "budget_explanation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "graph_id": {"type": "string", "minLength": 1},
    "graph_revision": {"type": "string", "minLength": 1},
    "capability_revision": {"type": "string", "minLength": 1},
    "compiler_revision": {"type": "string", "minLength": 1},
    "boundary_revision": {"type": "string", "minLength": 1},
    "provider_revision": {"type": "string", "minLength": 1},
    "model_route_revision": {"type": "string", "minLength": 1},
    "messages": {"type": "array", "items": {"type": "object"}},
    "layers": {
      "type": "object", "additionalProperties": false,
      "required": ["materials", "references", "conversation"],
      "properties": {"materials": {"type": "array"}, "references": {"type": "array"}, "conversation": {"type": "array"}}
    },
    "layer_token_costs": {
      "type": "object", "additionalProperties": false,
      "required": ["materials", "references", "conversation"],
      "properties": {"materials": {"type": "integer", "minimum": 0}, "references": {"type": "integer", "minimum": 0}, "conversation": {"type": "integer", "minimum": 0}}
    },
    "total_token_cost": {"type": "integer", "minimum": 0},
    "trimmed_nodes": {"type": "array", "items": {"type": "object"}},
    "excluded_nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "stale_nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "deterministic_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "budget_explanation": {"type": "object"}
  }
}
