{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas.local/contracts/context-graph-snapshot.schema.json",
  "title": "ContextGraphSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "graph_revision", "project_id", "source_type", "source_revision", "created_at", "nodes", "edges", "selected_outputs", "token_estimate", "provenance", "integrity_issues"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "graph_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "graph_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 128},
    "nodes": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 8000, "items": {"$ref": "#/$defs/edge"}},
    "selected_outputs": {"type": "array", "uniqueItems": true, "maxItems": 2000, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "token_estimate": {"type": "integer", "minimum": 0},
    "provenance": {"$ref": "#/$defs/provenance"},
    "integrity_issues": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/issue"}}
  },
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "node_type", "title", "content_ref", "content_revision", "source_refs", "trust", "created_at", "updated_at", "stale", "stale_reason", "metadata"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "node_type": {"enum": ["question", "answer", "material", "evidence", "note", "conclusion", "decision", "rejected_option", "document_draft", "project_skill_proposal", "memory_proposal", "research_synthesis"]},
        "title": {"type": "string", "maxLength": 512},
        "content_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 4096, "pattern": "^[A-Za-z][A-Za-z0-9+.-]{0,63}:[^\\s\\u0000-\\u001F]+$"}},
        "trust": {"enum": ["untrusted", "user_authored", "verified"]},
        "created_at": {"type": "string", "minLength": 1, "maxLength": 128},
        "updated_at": {"type": "string", "minLength": 1, "maxLength": 128},
        "stale": {"type": "boolean"},
        "stale_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "metadata": {"type": "object", "maxProperties": 128}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "source_node_id", "target_node_id", "context_mode", "depth", "ordering", "active", "metadata"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_node_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "target_node_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "context_mode": {"enum": ["full_chain", "quote_only", "highlights_only", "reference", "excluded"]},
        "depth": {"type": "integer", "minimum": 0, "maximum": 128},
        "ordering": {"type": "integer", "minimum": 0},
        "active": {"type": "boolean"},
        "metadata": {"type": "object", "maxProperties": 128}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "source_revision", "imported_at", "importer_id", "importer_revision", "source_ref", "untrusted_external_text"],
      "properties": {
        "source_type": {"type": "string", "minLength": 1, "maxLength": 128}, "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "imported_at": {"type": "string", "minLength": 1, "maxLength": 128}, "importer_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "importer_revision": {"type": "string", "minLength": 1, "maxLength": 256}, "source_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
        "untrusted_external_text": {"const": true}
      }
    },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "severity", "object_ref"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128}, "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "severity": {"enum": ["warning", "error"]}, "object_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
