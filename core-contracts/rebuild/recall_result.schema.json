{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas-replay.local/contracts/rebuild/recall_result.schema.json",
  "title": "RecallResult",
  "description": "项目问答和资料召回的结果合约，只返回可引用证据，不持久化最终回答。",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "recallLayer": {
      "type": "string",
      "enum": [
        "l4_persona",
        "l3_project_skill",
        "l3_persona",
        "l3_series_memory",
        "l2_scenario",
        "l1_atom",
        "l0_source"
      ]
    },
    "trustStatus": {
      "type": "string",
      "enum": [
        "trusted",
        "user_confirmed",
        "system_generated",
        "imported_unverified"
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hit_id",
        "layer",
        "object_id",
        "project_id",
        "source_project_label",
        "trust_status",
        "score",
        "token_estimate",
        "source_refs",
        "snippet",
        "explanation"
      ],
      "properties": {
        "hit_id": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "$ref": "#/$defs/recallLayer"
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "source_project_label": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "trust_status": {
          "$ref": "#/$defs/trustStatus"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "token_estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12000
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "snippet": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["insufficient_evidence", "index_unavailable", "budget_exceeded", "source_missing"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "request_id",
    "project_id",
    "status",
    "hits",
    "coverage",
    "truncation",
    "explanation",
    "cross_project",
    "errors",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["evidence_found", "partial", "insufficient_evidence", "index_unavailable"]
    },
    "hits": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/hit"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requested_layers",
        "covered_layers",
        "missing_layers",
        "low_trust",
        "source_ref_count"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["sufficient", "partial", "insufficient"]
        },
        "requested_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/recallLayer"
          }
        },
        "covered_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/recallLayer"
          }
        },
        "missing_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/recallLayer"
          }
        },
        "low_trust": {
          "type": "boolean"
        },
        "source_ref_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "reason", "dropped_hit_ids", "final_hit_count", "final_token_estimate"],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": ["none", "hit_limit", "token_limit", "trust_filter", "budget"]
        },
        "dropped_hit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "final_hit_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "final_token_estimate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12000
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "layer_order", "warnings"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "layer_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/recallLayer"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cross_project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "grant_id", "project_ids"],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "grant_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "project_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
