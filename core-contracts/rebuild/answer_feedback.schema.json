{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas-replay.local/contracts/rebuild/answer_feedback.schema.json",
  "title": "AnswerFeedback",
  "description": "回答结果进入记忆候选审核后的可追溯反馈记录。反馈对象只记录审核结果，不自动发布长期记忆。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "recall_result_id",
    "model_request_id",
    "model_result_id",
    "document_id",
    "memory_candidate_id",
    "candidate_status",
    "feedback_type",
    "source_refs",
    "review",
    "input_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "recall_result_id": {
      "type": "string",
      "minLength": 1
    },
    "model_request_id": {
      "type": "string",
      "minLength": 1
    },
    "model_result_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "memory_candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_status": {
      "type": "string",
      "enum": ["rejected", "promoted"]
    },
    "feedback_type": {
      "type": "string",
      "enum": ["candidate_rejected", "candidate_promoted_to_draft"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_by", "reviewed_at", "reason"],
      "properties": {
        "reviewed_by": {
          "type": "string",
          "enum": ["user", "system"]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inputRef"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "inputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "object_id", "uri"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["recall_result", "model_request", "model_result", "document", "memory_candidate"]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "pattern": "^crp://[a-z0-9][a-z0-9_-]*/.+$"
        }
      }
    }
  }
}
