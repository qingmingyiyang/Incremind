{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas-replay.local/contracts/rebuild/document.schema.json",
  "title": "Document",
  "description": "可编辑、可追溯、可版本管理的 Markdown 或文档产物当前快照。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "type",
    "project_id",
    "markdown_uri",
    "content_hash",
    "source_refs",
    "source_snapshot",
    "blocks",
    "revision",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "report",
        "project_doc",
        "summary",
        "qa_answer",
        "other"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "markdown_uri": {
      "type": "string",
      "pattern": "^crp://[a-z0-9][a-z0-9_-]*/documents/.+[.]md$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "source_snapshot": {
      "$ref": "#/$defs/sourceSnapshot"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/documentBlock"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived",
        "conflicted"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "snapshot_hash",
        "source_refs",
        "captured_at"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "documentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "block_type",
        "origin",
        "content",
        "source_refs",
        "edited_by_user",
        "lock_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "block_type": {
          "type": "string",
          "enum": [
            "heading",
            "paragraph",
            "list",
            "quote",
            "code",
            "table",
            "metadata"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "ai",
            "user",
            "import",
            "system"
          ]
        },
        "content": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "edited_by_user": {
          "type": "boolean"
        },
        "lock_policy": {
          "type": "string",
          "enum": [
            "none",
            "user_edit_protected",
            "source_required"
          ]
        }
      }
    }
  }
}
