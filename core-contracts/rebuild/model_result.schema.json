{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas-replay.local/contracts/rebuild/model_result.schema.json",
  "title": "ModelResult",
  "description": "Model Gateway 结果合约，固定输出、供应商、模型、用量、延迟、错误和安全语义。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "request_id",
    "status",
    "provider",
    "model",
    "output",
    "usage",
    "latency",
    "error",
    "safety",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["completed", "cancelled", "timeout", "provider_error", "privacy_blocked", "budget_exceeded", "invalid_response", "safety_blocked"]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "mode", "remote", "config_version"],
      "properties": {
        "provider_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["local", "remote", "none"]
        },
        "remote": {
          "type": "boolean"
        },
        "config_version": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "capability"],
      "properties": {
        "name": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "version": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "enum": ["text_generation", "structured_generation", "embedding", "vision", "transcription", "none"]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "content", "structured", "output_refs"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["text", "json", "embedding", "transcript", "none"]
        },
        "content": {
          "type": ["string", "null"]
        },
        "structured": {
          "type": ["object", "array", "null"]
        },
        "output_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "object_id", "uri"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["document", "atom", "scenario", "asset", "none"]
              },
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "pattern": "^crp://[a-z0-9][a-z0-9_-]*/.+$"
              }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "cost_usd", "currency"],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "none"]
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "elapsed_ms", "timed_out"],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "timed_out": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["cancelled", "timeout", "provider_unavailable", "provider_error", "privacy_blocked", "budget_exceeded", "invalid_response", "schema_validation_failed", "safety_blocked"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocked", "categories", "redaction_applied", "output_truncated"],
      "properties": {
        "blocked": {
          "type": "boolean"
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["privacy", "policy", "malware", "self_harm", "violence", "unknown"]
          }
        },
        "redaction_applied": {
          "type": "boolean"
        },
        "output_truncated": {
          "type": "boolean"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
