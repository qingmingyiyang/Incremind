{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas-replay.local/contracts/rebuild/persona.schema.json",
  "title": "Persona",
  "description": "L3 跨项目稳定的用户偏好、约束和长期事实。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "scope",
    "statements",
    "evidence_refs",
    "confirmation",
    "revision",
    "created_at",
    "updated_at",
    "trust_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "series",
        "project"
      ]
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/personaStatement"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "confirmation": {
      "$ref": "#/$defs/confirmation"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "trust_status": {
      "$ref": "#/$defs/trustStatus"
    }
  },
  "$defs": {
    "trustStatus": {
      "type": "string",
      "enum": [
        "trusted",
        "imported_unverified",
        "user_confirmed",
        "system_generated",
        "failed"
      ]
    },
    "personaStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "category",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "preference",
            "constraint",
            "identity",
            "workflow",
            "style",
            "other"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "object_id",
        "source_refs"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "enum": [
            "source",
            "atom",
            "scenario",
            "document"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "actor",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "confirmed",
            "rejected",
            "rule_allowed"
          ]
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
