{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas-replay.local/contracts/rebuild/memory_transition.schema.json",
  "title": "Memory Transition",
  "description": "记忆信任晋级、降级、撤销和 stale 标记的审计记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "object_type",
    "object_id",
    "transition_type",
    "from_trust_status",
    "to_trust_status",
    "from_revision",
    "to_revision",
    "actor",
    "reason",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "type": "string",
      "enum": [
        "atom",
        "scenario",
        "persona",
        "series_memory",
        "project_skill"
      ]
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "transition_type": {
      "type": "string",
      "enum": [
        "promote",
        "demote",
        "confirm",
        "reject",
        "mark_stale",
        "restore"
      ]
    },
    "from_trust_status": {
      "$ref": "#/$defs/trustStatus"
    },
    "to_trust_status": {
      "$ref": "#/$defs/trustStatus"
    },
    "from_revision": {
      "type": "integer",
      "minimum": 0
    },
    "to_revision": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "migration"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "trustStatus": {
      "type": "string",
      "enum": [
        "trusted",
        "imported_unverified",
        "user_confirmed",
        "system_generated",
        "failed"
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "object_id",
        "source_refs"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "enum": [
            "source",
            "atom",
            "scenario",
            "series_memory",
            "project_skill",
            "document"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string"
        }
      }
    }
  }
}
