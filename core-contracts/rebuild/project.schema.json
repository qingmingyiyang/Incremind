{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas-replay.local/contracts/rebuild/project.schema.json",
  "title": "Project",
  "description": "项目边界、Skill 绑定、系列关系和跨项目授权策略。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "purpose",
    "status",
    "series_ids",
    "skill_id",
    "document_ids",
    "default_scope",
    "cross_project_policy",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "archived"]
    },
    "series_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "skill_id": {
      "type": ["string", "null"]
    },
    "document_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "default_scope": {
      "type": "string",
      "enum": ["project_only", "series_only"]
    },
    "cross_project_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "grant_ids"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["disabled", "single_grant_required"]
        },
        "grant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
