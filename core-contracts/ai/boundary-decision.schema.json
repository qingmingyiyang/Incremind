{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crp://schemas/ai/boundary-decision-v1",
  "title": "Boundary Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "outcome", "reason_codes", "matched_grant_ids", "policy_revision", "requires_receipt", "redaction_required"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["allow", "allow_redacted", "ask", "deny"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "matched_grant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy_revision": {"type": "integer", "minimum": 1},
    "requires_receipt": {"type": "boolean"},
    "redaction_required": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "allow_redacted"}}},
      "then": {"properties": {"redaction_required": {"const": true}}}
    }
  ]
}
