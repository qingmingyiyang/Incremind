{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crp://schemas/ai/tool-invocation-outcome-v1",
  "title": "AI Tool Invocation Outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "turn_id", "capability_id", "attempt", "status", "payload_ref", "receipt_ref", "evidence_refs", "error_code", "retryable"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "invocation_id": {"type": "string", "pattern": "^tool-call-[0-9a-f]{32}$"},
    "turn_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 10},
    "status": {"enum": ["completed", "failed", "cancelled", "timed_out", "unknown_effect"]},
    "effect_certainty": {"description": "Current producers always emit this field; omission is accepted only for historical V1 payloads.", "enum": ["confirmed_none", "confirmed_applied", "unknown"]},
    "payload_ref": {"type": ["string", "null"], "pattern": "^crp://.+$"},
    "receipt_ref": {"type": ["string", "null"], "pattern": "^crp://.+$"},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^crp://.+$"}},
    "error_code": {"type": ["string", "null"], "minLength": 1},
    "retryable": {"type": "boolean"}
  }
}
