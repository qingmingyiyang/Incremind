{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://chriptmas-os.local/contracts/ai/agent-operation-receipt.schema.json","type":"object","additionalProperties":false,"required":["schema_version","kind","capability_id","operation_id","tool_call_id","turn_id","project_id","status"],"properties":{"schema_version":{"const":"1.0.0"},"kind":{"const":"agent.operation.receipt.v1"},"capability_id":{"enum":["agent.spawn","agent.message","agent.interrupt","agent.fan_in","agent.plan"]},"operation_id":{"type":"string","pattern":"^op-[A-Za-z0-9._~-]{8,125}$"},"tool_call_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"},"turn_id":{"type":"string","pattern":"^turn-[0-9a-f]{32}$"},"project_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"},"status":{"const":"completed"}}}
