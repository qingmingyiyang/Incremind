{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriptmas-os.local/contracts/ai/model-wire-attempt-receipt.schema.json",
  "title": "AI Model Wire Attempt Receipt",
  "description": "Metadata-only terminal receipt for exactly one real provider wire attempt. It excludes prompts, outputs, provider bodies, endpoints, paths, credentials, and error text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt_id", "turn_id", "model_request_id", "attempt_number",
    "routing_snapshot_revision", "provider_id", "model_id", "status", "started_at",
    "completed_at", "duration_ms", "usage_status", "usage", "cache_status",
    "cache_metadata", "input_stored", "output_stored", "error_code"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "attempt_id": {"type": "string", "pattern": "^model-wire-attempt-[A-Za-z0-9._~-]{8,109}$"},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"},
    "model_request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"},
    "attempt_number": {"type": "integer", "minimum": 1, "maximum": 10000},
    "routing_snapshot_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~/-]{0,127}$"},
    "execution_location": {"enum": ["remote", "local_loopback"]},
    "status": {"enum": ["succeeded", "failed_transport", "consumer_cancelled"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "usage_status": {"enum": ["reported", "unavailable"]},
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "total_tokens": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "cache_status": {"enum": ["reported", "unavailable"]},
    "cache_metadata": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source_format", "cache_read_input_tokens", "cache_write_input_tokens", "uncached_input_tokens"],
      "properties": {
        "source_format": {"const": "provider_usage"},
        "cache_read_input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
        "cache_write_input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
        "uncached_input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647}
      }
    },
    "input_stored": {"const": false},
    "output_stored": {"const": false},
    "error_code": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_.-]{2,127}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"usage_status": {"const": "reported"}}},
      "then": {"properties": {"usage": {"type": "object"}}}
    },
    {
      "if": {"properties": {"usage_status": {"const": "unavailable"}}},
      "then": {"properties": {"usage": {"type": "null"}}}
    },
    {
      "if": {"properties": {"cache_status": {"const": "reported"}}},
      "then": {
        "properties": {"cache_metadata": {"type": "object"}},
        "anyOf": [
          {"properties": {"cache_metadata": {"properties": {"cache_read_input_tokens": {"type": "integer"}}}}},
          {"properties": {"cache_metadata": {"properties": {"cache_write_input_tokens": {"type": "integer"}}}}},
          {"properties": {"cache_metadata": {"properties": {"uncached_input_tokens": {"type": "integer"}}}}}
        ]
      }
    },
    {
      "if": {"properties": {"cache_status": {"const": "unavailable"}}},
      "then": {"properties": {"cache_metadata": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {"properties": {"error_code": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["failed_transport", "consumer_cancelled"]}}},
      "then": {"properties": {"error_code": {"type": "string"}}}
    },
    {
      "if": {"properties": {"status": {"const": "consumer_cancelled"}}},
      "then": {"properties": {"error_code": {"const": "ai.consumer_cancelled"}}}
    }
  ]
}
