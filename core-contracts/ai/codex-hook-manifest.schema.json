{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crp://schemas/ai/codex-hook-manifest-v1",
  "title": "Codex Hook Manifest",
  "description": "A safe, declarative registry of in-process Codex hook handlers. Commands, payloads, secrets, and local paths are intentionally outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "manifest_id", "revision", "upstream_revision", "handlers", "audit_delivery"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "codex-hook-manifest"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/revision"},
    "upstream_revision": {"const": "0fe877b4dedc86a29c8bebb3edbd3efcc3580c7d"},
    "handlers": {"type": "array", "items": {"$ref": "#/$defs/handler"}},
    "audit_delivery": {"const": "async_best_effort"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "event": {"enum": ["PreToolUse", "PermissionRequest", "PostToolUse", "PreCompact", "PostCompact", "SessionStart", "SessionEnd", "UserPromptSubmit", "SubagentStart", "SubagentStop", "Stop"]},
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handler_id", "handler_revision", "event", "order", "sync", "handler_ref", "timeout_ms"],
      "properties": {
        "handler_id": {"$ref": "#/$defs/id"},
        "handler_revision": {"$ref": "#/$defs/revision"},
        "event": {"$ref": "#/$defs/event"},
        "order": {"type": "integer", "minimum": 0},
        "sync": {"type": "boolean"},
        "handler_ref": {"type": "string", "pattern": "^crp://[A-Za-z0-9._~:/-]+$"},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
      }
    }
  }
}
