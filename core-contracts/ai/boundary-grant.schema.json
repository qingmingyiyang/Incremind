{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crp://schemas/ai/boundary-grant-v1",
  "title": "Boundary Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "subject_id", "project_id", "target_id", "actions", "data_classes", "destinations", "expires_at", "revision", "revoked", "redaction_required"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "grant_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read", "write", "external", "platform", "delete"]}},
    "data_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "destinations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["local", "provider", "mcp", "platform"]}},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "revoked": {"type": "boolean"},
    "redaction_required": {"type": "boolean"}
  }
}
