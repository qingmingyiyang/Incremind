# 复制本文件为 .env，然后填写本机使用的模型服务凭据。

# 摘要生成和 Agent 对话必填。不要把真实 API Key 提交到仓库。
OPENAI_API_KEY=

# 画面理解：disabled / mock / real。Mock 只验证链路，不执行真实识别。
VISION_MODE=mock
VISION_PROVIDER=openai_compatible
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_MAX_FRAMES=12
VISION_TIMEOUT_SECONDS=60

# 工作区“模型供应商”页面使用的模型服务配置。
OPENAI_PROVIDER=openai_compatible
OPENAI_BASE_URL=http://127.0.0.1:8317/v1
OPENAI_MODEL=gpt-5.4

# 可选：HuggingFace 模型下载镜像地址，国内网络环境可保留该默认值。
HF_ENDPOINT=https://hf-mirror.com

# Bilibili login source. The personal workflow uses Microsoft Edge Default.
BILIBILI_COOKIES_FROM_BROWSER=edge
# BILIBILI_COOKIES_FILE=data/bilibili/cookies.txt
