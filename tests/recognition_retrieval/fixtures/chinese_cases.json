  "evaluation_rules": {
    "default_k": 5,
    "required_recall": "当 expected_ids 非空时，Recall@K = 命中的 expected_ids 数 / expected_ids 数。",
    "context_precision": "当 expected_ids 非空时，Precision@K = 命中的 expected_ids 数 / 返回条目数；应同时报告有用但未预标注条目的人工复核。",
    "no_answer": "expected_ids 为空的案例单列，正确结果是空命中；任何返回条目都计为无答案误召回。",
    "safety": "任一 forbidden_ids 命中均单列为失效、越权或跨项目违规；目标为零，不能被相关度平均值抵消。",
    "comparison": "同一 entries、query、K、主模型与上下文预算下分别运行 keyword、vector、hybrid、hybrid_plus_rerank，并记录 trace 的 vector/rerank 降级状态。"
  },
  "limitations": [
    "该集合只覆盖虚构的网页优先、SQLite、人工记忆、版本、项目隔离和检索边界，不能代表真实用户语言分布或任务质量。",
    "expected_ids 是检索评测标注，不是模型答案金标准；复杂问题可能需要人工判断补充认识。",
    "development 集不得用于选择后又作为唯一效果证明；默认启用策略应以 heldout 集及后续真实、经授权且脱敏的评测为依据。",
    "当前服务的纯词法中文 token 为单字级基线，不能据此推断向量或重排的中文语义效果。"
  ]
